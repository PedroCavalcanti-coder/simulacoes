

float HashScale;
float3 HashSize;
float3 HashTranslate;

RWStructuredBuffer<int2> IndexMap;
RWStructuredBuffer<int2> Table;

int3 HashIndex(float3 p)
{
	p = (p - HashTranslate) * HashScale;
	return clamp(p, 0, HashSize - 1);
}

float KernelRadius;
float KernelRadius2;

float Poly6Zero;
float Poly6;
float SpikyGrad;
float ViscLap;

float Pow2(float v)
{
	return v * v;
}

float Pow3(float v)
{
	return v * v * v;
}

float Poly6Kernel(float len2)
{
	return Poly6 * Pow3(KernelRadius2 - len2);
}

float3 SpikyGradKernel(float3 p, float len2)
{
	// r clampado: 2 particulas coincidentes (len2~0) davam p/r = 0/0 = NaN. Sob compressao
	// (fluido contido no fundo) particulas se sobrepoem -> NaN e propaga. max(r,eps) mata isso.
	float r = max(sqrt(len2), 1e-5);
	return (p / r) * SpikyGrad * Pow2(KernelRadius - r);
}

float ViscLapKernel(float len2)
{
	float r = sqrt(len2);
	return ViscLap * (KernelRadius - r);
}

#define THREADS 128
#define PI 3.14159265359

RWStructuredBuffer<float4> Positions;
StructuredBuffer<float4> PredictedREAD;
RWStructuredBuffer<float4> PredictedWRITE;
StructuredBuffer<float4> VelocitiesREAD;
RWStructuredBuffer<float4> VelocitiesWRITE;
RWStructuredBuffer<float> Densities;
RWStructuredBuffer<float> Pressures;

// Estado por particula: 0 = viva, 1 = morta (despawnada, estacionada no cemiterio).
// SEM "congelar por assentamento" (hack removido) — fisica sempre integra vivas.
RWStructuredBuffer<float> States;

// limites anti-"pipoca" (estabilidade PBF). CFL/clamps sao invariantes de escala:
// bounded o estrago mesmo se Relaxation estiver mal calibrado.
float MaxSpeed;       // vel max por substep (CFL) = CFL * cellSize / dt
float MaxCorrection;  // correcao max de posicao por iteracao de densidade (~0.4*raio)
float Relaxation;     // epsilon CFM no denominador de lambda (era hardcoded 60)

// AMORTECIMENTO ADAPTATIVO p/ REPOUSO (dissipacao viscosa: KE -> calor).
// Liquido real PARA com o tempo e so se move quando algo o move (Newton). PBF puro
// nunca dissipa a energia residual do solver -> agitacao perpetua. Aqui: amortecimento
// FORTE em baixa velocidade (assenta rapido e fica em repouso) e FRACO em alta (jato/
// derrame continua vivo). Interpola por velocidade:
//   damp = lerp(RestDamping, MoveDamping, saturate(speed / DampRefSpeed))
//   v *= (1 - damp*dt)
float Cohesion;      // aceleracao (m/s2) da coesao entre vizinhos. 0 = desligada
float RestDamping;   // 1/s em repouso (alto = assenta rapido). ~6
float MoveDamping;   // 1/s em movimento rapido (baixo = jato vivo). ~0.2
float DampRefSpeed;  // vel (m/s) onde ja e' "rapido" (usa MoveDamping). ~0.35

// ID logico da substancia. O renderer filtra por ele; 0xFFFFFFFF = slot morto,
// que o vertex shader do SSF ja descarta sem precisar conhecer States.
RWStructuredBuffer<uint> SubstanceIds;

// Instante absoluto (SimTime) em que cada particula deve morrer de velhice.
RWStructuredBuffer<float> DeathTimes;

// Slots que morreram neste passo: (slot, porto+1). porto+1 = 0 significa morte por
// tempo de vida; >0 identifica o frasco que capturou a particula. A CPU le isto de
// forma assincrona para devolver o slot a lista livre e creditar o volume.
AppendStructuredBuffer<uint2> Deaths;

float SimTime;
float3 Graveyard;    // onde a particula morta fica estacionada, fora de vista

// Bocas de frasco. Particula que entra numa delas e capturada: some do jato e vira
// volume no recipiente. Testado no mesmo kernel que confirma a posicao, entao a
// amostragem e por substep e nao por frame - jato rapido nao atravessa mais a boca
// entre duas leituras.
struct PortGPU
{
	float3 center;
	float radius;
	float3 normal;
	float captureDepth;
};
StructuredBuffer<PortGPU> Ports;
int PortCount;
float PortEntryDepth;   // quanto acima do plano da boca ja conta como dentro

float3 Gravity;
float Dampning;
float DeltaTime;
float Density;
float Viscosity;
float ParticleMass;
int NumParticles;

bool IsDead(int id) { return States[id] > 0.5; }

float3 Velocity(int i)
{

	float3 velocity = VelocitiesREAD[i].xyz;
	velocity -= velocity * Dampning * DeltaTime;
	velocity += DeltaTime * Gravity;

	return velocity;
}

float3 PredictedPosition(int i, float3 velocity)
{
	return Positions[i].xyz + DeltaTime * velocity;
}

#pragma kernel PredictPositions

[numthreads(THREADS,1,1)]
void PredictPositions(int id : SV_DispatchThreadID)
{
	if (id < NumParticles)
	{
		if (IsDead(id))
		{
			VelocitiesWRITE[id] = float4(0, 0, 0, 0);
			PredictedWRITE[id] = Positions[id];   // morta: estacionada
			return;
		}

		float3 velocity = Velocity(id);
		float3 predicted = PredictedPosition(id, velocity);

		VelocitiesWRITE[id] = float4(velocity, 0);
		PredictedWRITE[id] = float4(predicted, 0);
	}

}

float Distance2(float3 a, float3 b)
{
	float3 ab = a - b;
	return dot(ab,ab);
}

float Length2(float3 p)
{
	return dot(p, p);
}

#define LOOP_START \
[unroll] \
for (int k = -1; k <= 1; k++) \
{ \
[unroll] \
for (int j = -1; j <= 1; j++) \
{ \
[unroll] \
for (int i = -1; i <= 1; i++) \
{ \

#define LOOP_END \
} } } \

void ComputeDensityAndPressure(int id, float3 pi, out float density, out float pressure)
{

	float InvDensity = 1.0f / Density;
	float MassMulInvDensity = ParticleMass * InvDensity;

	density = ParticleMass * Poly6Zero;
	pressure = 0;

	float sum_grad_C2 = 0.0f;
	float3 gradC_i = 0.0f;

	int3 hashIndex = HashIndex(pi);
	int3 size = HashSize;
	int sizexy = size.x * size.y;

	LOOP_START

	int xi = hashIndex.x + i;
	int yj = hashIndex.y + j;
	int zk = hashIndex.z + k;

	if (xi < 0 || xi >= size.x) continue;
	if (yj < 0 || yj >= size.y) continue;
	if (zk < 0 || zk >= size.z) continue;

	int hash = xi + yj * size.x + zk * sizexy;
	int2 bounds = Table[hash];

	for (int idx = bounds.x; idx <= bounds.y; idx++)
	{
		int n = IndexMap[idx].y;
		if (n == id) continue;

		float3 diff = pi - PredictedREAD[n].xyz;
		float dist2 = Length2(diff);
		if (dist2 >= KernelRadius2) continue;

		density += ParticleMass * Poly6Kernel(dist2);
		float3 gradC_j = -MassMulInvDensity * SpikyGradKernel(diff, dist2);
		sum_grad_C2 += dot(gradC_j, gradC_j);
		gradC_i -= gradC_j;
	}

	LOOP_END

	float C = density * InvDensity - 1.0f;

	if (C > 0)
	{
		// C > 0 for 60% - 65% of particles
		sum_grad_C2 += Length2(gradC_i);
	
		//Relaxation (CFM) estabiliza a pressao com gradiente que some nas
		//bordas do kernel. Agora e' uniform (Relaxation), calibravel no painel.
		pressure = -C / (sum_grad_C2 + Relaxation);
	}

}

#pragma kernel ComputeDensity

[numthreads(THREADS, 1, 1)]
void ComputeDensity(int id : SV_DispatchThreadID)
{
	if (id < NumParticles)
	{
		float3 pi = PredictedREAD[id].xyz;

		float density, pressure;
		ComputeDensityAndPressure(id, pi, density, pressure);

		Densities[id] = density;
		Pressures[id] = pressure;

	}
}

float3 SolveDensity(int id, float3 pi, float pressure)
{

	float3 corr = 0;
	float InvDensity = 1.0f / Density;
	float MassMulInvDensity = ParticleMass * InvDensity;

	int3 hashIndex = HashIndex(pi);
	int3 size = HashSize;
	int sizexy = size.x * size.y;

	LOOP_START

	int xi = hashIndex.x + i;
	int yj = hashIndex.y + j;
	int zk = hashIndex.z + k;

	if (xi < 0 || xi >= size.x) continue;
	if (yj < 0 || yj >= size.y) continue;
	if (zk < 0 || zk >= size.z) continue;

	int hash = xi + yj * size.x + zk * sizexy;
	int2 bounds = Table[hash];

	for (int idx = bounds.x; idx <= bounds.y; idx++)
	{
		int n = IndexMap[idx].y;
		if (n == id) continue;

		float3 diff = pi - PredictedREAD[n].xyz;
		float dist2 = Length2(diff);
		if (dist2 >= KernelRadius2) continue;

		float3 gradW = SpikyGradKernel(diff, dist2);
		corr -= (pressure + Pressures[n]) * -MassMulInvDensity * gradW;
	}

	LOOP_END

	return corr;
}

#pragma kernel SolveConstraint

[numthreads(THREADS, 1, 1)]
void SolveConstraint(int id : SV_DispatchThreadID)
{
	if (id < NumParticles)
	{
		if (IsDead(id)) { PredictedWRITE[id] = PredictedREAD[id]; return; }

		float3 pi = PredictedREAD[id].xyz;
		float pressure = Pressures[id];

		float3 corr = SolveDensity(id, pi, pressure);
		float cl = length(corr);
		if (cl > MaxCorrection) corr *= MaxCorrection / cl;   // clamp anti-pipoca
		pi += corr;

		PredictedWRITE[id] = float4(pi, 0);
	}
}

// ============================================================================
//  COLISORES por LAYER (C2): primitivas analiticas (sphere/box/capsule/plane).
//  Empurra a particula p/ FORA da primitiva. Atualizado por frame (segue Transforms).
// ============================================================================
struct ColliderGPU
{
	int type;         // 0 sphere, 1 box, 2 capsule, 3 plane
	float3 center;    // mundo
	float3 axisX;     // base ortonormal (mundo)
	float3 axisY;
	float3 axisZ;
	float3 halfExt;   // box: meias-extensoes; capsule: (_, meia-altura do segmento, _)
	float radius;     // sphere/capsule raio
	float3 velocity;  // vel. do colisor (mundo) — arrasta o fluido (atrito)
};
StructuredBuffer<ColliderGPU> Colliders;
int ColliderCount;
float ColliderClearance;   // folga = raio da particula
float ColliderFriction;    // 0..1: quanto o colisor em MOVIMENTO arrasta o fluido (atrito)

// sd (negativo = dentro) + normal (mundo) em outN. wp = pos mundo.
float ColliderSDF(ColliderGPU c, float3 wp, out float3 outN)
{
	float3 dd = wp - c.center;
	float3 lp = float3(dot(dd, c.axisX), dot(dd, c.axisY), dot(dd, c.axisZ)); // local

	if (c.type == 0) // sphere
	{
		float len = length(lp);
		float3 nl = (len > 1e-6) ? lp / len : float3(0, 1, 0);
		outN = nl.x * c.axisX + nl.y * c.axisY + nl.z * c.axisZ;
		return len - c.radius;
	}
	else if (c.type == 2) // capsule (eixo = axisY local)
	{
		float3 pp = lp;
		pp.y -= clamp(pp.y, -c.halfExt.y, c.halfExt.y); // ponto no segmento
		float len = length(pp);
		float3 nl = (len > 1e-6) ? pp / len : float3(0, 1, 0);
		outN = nl.x * c.axisX + nl.y * c.axisY + nl.z * c.axisZ;
		return len - c.radius;
	}
	else if (c.type == 3) // plane (normal = axisY local)
	{
		outN = c.axisY;
		return dot(dd, c.axisY);   // dist assinada (positivo acima)
	}
	else // box (type 1)
	{
		float3 he = c.halfExt;
		float3 q = abs(lp) - he;
		float3 nl;
		float sd;
		if (max(q.x, max(q.y, q.z)) > 0.0)             // fora
		{
			float3 cp = clamp(lp, -he, he);
			float3 diff = lp - cp;
			float dist = length(diff);
			nl = (dist > 1e-6) ? diff / dist : float3(0, 1, 0);
			sd = dist;
		}
		else                                            // dentro: face mais proxima
		{
			float3 pen = he - abs(lp);
			if (pen.x <= pen.y && pen.x <= pen.z)      { nl = float3(sign(lp.x), 0, 0); sd = -pen.x; }
			else if (pen.y <= pen.z)                   { nl = float3(0, sign(lp.y), 0); sd = -pen.y; }
			else                                        { nl = float3(0, 0, sign(lp.z)); sd = -pen.z; }
		}
		outN = nl.x * c.axisX + nl.y * c.axisY + nl.z * c.axisZ;
		return sd;
	}
}

#pragma kernel SolveColliders

[numthreads(THREADS, 1, 1)]
void SolveColliders(int id : SV_DispatchThreadID)
{
	if (id < NumParticles)
	{
		if (IsDead(id)) { PredictedWRITE[id] = PredictedREAD[id]; return; }

		float3 p = PredictedREAD[id].xyz;
		for (int c = 0; c < ColliderCount; c++)
		{
			float3 n;
			ColliderGPU col = Colliders[c];
			float sd = ColliderSDF(col, p, n);
			if (sd < ColliderClearance)
			{
				p += n * (ColliderClearance - sd);          // empurra p/ fora + folga
				// ATRITO self-limitado: puxa a velocidade da particula p/ a do colisor (nao ULTRAPASSA).
				// rel = vel_colisor - vel_particula; colisor parado + particula parada => 0 (desliza
				// livre). Colisor movendo => leva o fluido junto ate' igualar a vel dele (ColliderFriction
				// = quao rapido converge). Antes era +col.velocity*dt (ACUMULAVA -> fluido mais rapido
				// que o colisor).
				float3 relVel = col.velocity - VelocitiesREAD[id].xyz;
				p += relVel * DeltaTime * ColliderFriction;
			}
		}
		PredictedWRITE[id] = float4(p, 0);
	}
}

#pragma kernel UpdateVelocities

[numthreads(THREADS, 1, 1)]
void UpdateVelocities(int id : SV_DispatchThreadID)
{
	if (id < NumParticles)
	{
		if (IsDead(id)) { VelocitiesWRITE[id] = float4(0, 0, 0, 0); return; }

		float3 p = Positions[id].xyz;
		float3 pi = PredictedREAD[id].xyz;

		float3 velocity = (pi - p) / DeltaTime;

		// clamp CFL: mata "pipoca" (uma correcao ruim nao lanca a particula)
		float s = length(velocity);
		if (s > MaxSpeed) { velocity *= MaxSpeed / s; s = MaxSpeed; }

		// dissipacao p/ REPOUSO (Newton): forte devagar, fraca rapido.
		float damp = lerp(RestDamping, MoveDamping, saturate(s / max(DampRefSpeed, 1e-5)));
		velocity *= max(0.0, 1.0 - damp * DeltaTime);

		VelocitiesWRITE[id] = float4(velocity, 0);
	}
}

// Spline de coesao de Akinci, normalizada para valer 1 no seu maximo (r = h/2).
// Com isso Cohesion e uma aceleracao em m/s2, comparavel com a gravidade, em vez de
// um numero que muda de ordem de grandeza toda vez que o raio da particula muda.
float CohesionSpline01(float r)
{
	float h = KernelRadius;
	if (r <= 0.0 || r >= h) return 0.0;

	float a = h - r;
	float w = (2.0 * r > h)
		? a * a * a * r * r * r
		: 2.0 * a * a * a * r * r * r - (h * h * h * h * h * h) / 64.0;

	// 32/(pi h^9) e a normalizacao original; multiplicar por 2 pi h^3 leva o pico a 1.
	return w * 64.0 / (h * h * h * h * h * h);
}

float3 ComputeViscosity(int id, float3 pi)
{

	float viscosityMulMass = Viscosity * ParticleMass;
	float3 cohesionAccel = 0;

	int3 hashIndex = HashIndex(pi);
	int3 size = HashSize;
	float sizexy = size.x * size.y;

	float3 velocity = VelocitiesREAD[id].xyz;

	LOOP_START

	int xi = hashIndex.x + i;
	int yj = hashIndex.y + j;
	int zk = hashIndex.z + k;

	if (xi < 0 || xi >= size.x) continue;
	if (yj < 0 || yj >= size.y) continue;
	if (zk < 0 || zk >= size.z) continue;

	int hash = xi + yj * size.x + zk * sizexy;
	int2 bounds = Table[hash];

	for (int idx = bounds.x; idx <= bounds.y; idx++)
	{
		int n = IndexMap[idx].y;
		if (n == id) continue;

		float3 pn = PredictedREAD[n].xyz;
		float dist2 = Distance2(pi, pn);
		if (dist2 >= KernelRadius2) continue;

		// COESAO: puxa a particula na direcao dos vizinhos. No interior os vizinhos
		// cercam a particula e a soma se cancela; na superficie ela e' puxada para
		// dentro. E isso que faz o jato sair como filete continuo que se parte em
		// gotas, em vez de um colar de esferas independentes.
		float dist = sqrt(dist2);
		cohesionAccel -= Cohesion * CohesionSpline01(dist) * ((pi - pn) / max(dist, 1e-6));

		// XSPH: peso = kernel NORMALIZADO (Poly6). Sum_j (m_j/rho_j) Poly6 ~= 1, entao
		// o blend fica limitado por Viscosity (c in [0,1]) e e' INVARIANTE DE ESCALA.
		// (Antes usava ViscLapKernel ~ 1/h^6 => coef ~1/h^2 por vizinho: p/ raio pequeno
		//  dava ~0.95 por vizinho * N vizinhos >> 1 => XSPH dispara => explosao/pipoca.)
		float invDensity = 1.0f / Densities[n];
		float v = Poly6Kernel(dist2) * viscosityMulMass * invDensity;
		velocity += v * (VelocitiesREAD[n].xyz - velocity);
	}

	LOOP_END

	return velocity + cohesionAccel * DeltaTime;

}

#pragma kernel SolveViscosity

[numthreads(THREADS, 1, 1)]
void SolveViscosity(int id : SV_DispatchThreadID)
{
	if (id < NumParticles)
	{
		if (IsDead(id)) { VelocitiesWRITE[id] = float4(0, 0, 0, 0); return; }

		float3 pi = PredictedREAD[id].xyz;

		float3 velocity = ComputeViscosity(id, pi);

		VelocitiesWRITE[id] = float4(velocity,0);
	}
}

// Mata o slot: estaciona no cemiterio, esconde do renderer e avisa a CPU. Todo
// caminho de morte passa por aqui, para que a lista de slots livres tenha uma unica
// fonte. portPlusOne = 0 -> morreu de velhice; > 0 -> foi capturada pelo porto - 1.
void KillParticle(int id, uint portPlusOne)
{
	States[id] = 1.0;
	Positions[id] = float4(Graveyard, 0);
	SubstanceIds[id] = 0xFFFFFFFF;
	Deaths.Append(uint2((uint)id, portPlusOne));
}

// A particula entrou na boca deste frasco? Dois testes: onde ela parou, e o segmento
// que percorreu. O segundo existe porque uma gota rapida pode atravessar o plano
// inteiro da boca dentro de um unico substep.
bool EntersPort(PortGPU port, float3 pOld, float3 pNew)
{
	float3 dNew = pNew - port.center;
	float axial = dot(dNew, port.normal);
	float3 radial = dNew - port.normal * axial;
	float r2 = port.radius * port.radius;

	if (axial <= PortEntryDepth && axial >= -port.captureDepth && dot(radial, radial) <= r2)
		return true;

	float axialOld = dot(pOld - port.center, port.normal);
	float denom = axialOld - axial;
	if (axialOld >= 0.0 && axial <= 0.0 && abs(denom) > 1e-6)
	{
		float t = saturate(axialOld / denom);
		float3 hit = lerp(pOld, pNew, t) - port.center;
		float3 hitRadial = hit - port.normal * dot(hit, port.normal);
		if (dot(hitRadial, hitRadial) <= r2)
			return true;
	}

	return false;
}

#pragma kernel UpdatePositions

[numthreads(THREADS, 1, 1)]
void UpdatePositions(int id : SV_DispatchThreadID)
{
	if (id >= NumParticles) return;
	if (IsDead(id)) return;

	float3 pOld = Positions[id].xyz;
	float3 pNew = PredictedREAD[id].xyz;

	for (int c = 0; c < PortCount; c++)
	{
		if (EntersPort(Ports[c], pOld, pNew))
		{
			KillParticle(id, (uint)(c + 1));
			return;
		}
	}

	if (SimTime >= DeathTimes[id])
	{
		KillParticle(id, 0);
		return;
	}

	Positions[id] = float4(pNew, 0);
}

// ============================================================================
//  NASCIMENTO. A CPU escolhe slots livres e preenche um buffer pequeno de tamanho
//  fixo; este kernel os grava. Nenhuma realocacao de ComputeBuffer, nenhum
//  readback sincrono - era esse o custo que fazia o derrame engasgar.
//
//  Predicted nao e inicializado de proposito: PredictPositions reescreve o slot
//  inteiro a partir de Positions no comeco do proximo passo.
// ============================================================================
// Tres linhas de 16 bytes, de proposito. Um struct que alterna float3 e uint deixa o
// empacotamento a cargo das regras do HLSL, que nao sao as do C#: o layout casaria por
// sorte, e um dia deixaria de casar sem nenhum erro de compilacao - so particulas
// nascendo com velocidade e tempo de vida trocados.
struct SpawnRecord
{
	float4 position;   // xyz = posicao, w = instante da morte
	float4 velocity;   // xyz = velocidade, w livre
	uint4 ids;         // x = substancia, y = slot, zw livres
};
StructuredBuffer<SpawnRecord> Spawns;
int SpawnCount;

// Ligado ao Velocities[READ] do momento do dispatch: e de la que o PredictPositions
// do proximo passo vai ler a velocidade inicial.
RWStructuredBuffer<float4> SpawnVelocities;

#pragma kernel SpawnParticles

[numthreads(THREADS, 1, 1)]
void SpawnParticles(int id : SV_DispatchThreadID)
{
	if (id >= SpawnCount) return;

	SpawnRecord s = Spawns[id];
	uint slot = s.ids.y;

	Positions[slot] = float4(s.position.xyz, 0);
	SpawnVelocities[slot] = float4(s.velocity.xyz, 0);
	SubstanceIds[slot] = s.ids.x;
	DeathTimes[slot] = s.position.w;
	States[slot] = 0.0;
	Densities[slot] = 0;
	Pressures[slot] = 0;
}
